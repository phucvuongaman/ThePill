  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TheProject.NewGameIntroUI
  _panel: {fileID: 0}
  _bodyText: {fileID: 0}
  _fadeDuration: 0.6
  _holdDuration: 0.1
  _startDelay: 1.2
  _slides:
  - "\"Anh ph\u1EA3i u\u1ED1ng thu\u1ED1c \u0111\xFAng gi\u1EDD.\nN\xF3 s\u1EBD gi\xFAp
    anh qu\xEAn \u0111i nh\u1EEFng chuy\u1EC7n kh\xF4ng hay.\nNh\u1EDB nh\xE9, \u0111\u1EEBng
    qu\xEAn l\u1EA7n n\xE0y.\"\n\u2014 B\xE1c s\u0129"
  - "Ba tu\u1EA7n k\u1EC3 t\u1EEB khi t\xF4i chuy\u1EC3n\nv\xE0o c\u0103n nh\xE0
    n\xE0y."
  - "H\xE0ng x\xF3m b\u1EA3o khu n\xE0y\ntr\u01B0\u1EDBc \u0111\xE2y c\xF3 chuy\u1EC7n
    kh\xF4ng hay."
  - "\u0110\xEAm qua t\xF4i l\u1EA1i nghe\nti\u1EBFng b\u01B0\u1EDBc ch\xE2n."
  - "Nh\u01B0ng h\u1EB3n ch\u1EC9 l\xE0 t\xF4i\n\u0111ang qu\xE1 m\u1EC7t th\xF4i."
